# Copy this file to api/.env for local development. api/.env is ignored by Git.
# Keep every real credential only in api/.env or a production secret manager.
# A process environment variable always overrides the matching value in this file.

# ASP.NET Core hosting
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7080;http://localhost:5080
AllowedHosts=localhost;127.0.0.1

# Database and Redis connection strings (required secrets)
ConnectionStrings__DefaultConnection=
ConnectionStrings__Redis=

# Cloudinary avatar storage
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Redis behavior
Redis__KeyPrefix=sv5t:
Redis__ConnectTimeoutMilliseconds=5000
Redis__OperationTimeoutMilliseconds=5000
Redis__KeepAliveSeconds=60
Redis__LoginMaxAttempts=5
Redis__LoginIpMaxAttempts=20
Redis__LoginBlockMinutes=15
Redis__RequireAuthentication=true
Redis__RequireTls=false

# JWT access and refresh tokens
Jwt__Issuer=SV5T.Api
Jwt__Audience=SV5T.Frontend
Jwt__Key=
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenIdleMinutes=120
Jwt__RefreshTokenDays=7
Jwt__MaxConcurrentSessions=5

# OTP and stable identifier hashing (use two different random secrets)
Otp__Pepper=
Otp__ExpirySeconds=180
Otp__ResendSeconds=60
Otp__MaxAttempts=5
Otp__MaxRequestsPerHour=5
IdentifierHash__Key=

# SMTP email
EmailSettings__SmtpHost=smtp-relay.brevo.com
EmailSettings__SmtpPort=587
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__FromName=SV5T
EmailSettings__FromAddress=
EmailSettings__StartTls=true
EmailSettings__DailyRecipientLimit=300
EmailSettings__PasswordResetReserve=50
EmailSettings__RetryDelaySeconds=60
EmailSettings__MaxDeliveryAttempts=3
EmailSettings__MaxPendingMessages=10000
EmailSettings__DeadLetterRetentionDays=30
EmailSettings__DeadLetterMaxLength=1000

# School and browser access
SchoolEmail__AllowedDomains__0=ms.hanu.edu.vn
Cors__AllowedOrigins__0=https://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5173
ReverseProxy__KnownProxies__0=127.0.0.1
HealthChecks__ReadyAllowedHosts__0=localhost
HealthChecks__ReadyAllowedHosts__1=127.0.0.1

# Data protection and PII encryption
DataProtection__KeysPath=../.data-protection-keys
DataProtection__CertificatePath=
DataProtection__CertificatePassword=
PiiEncryption__ReencryptOnStart=false
PiiEncryption__BatchSize=100

# Logging
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft=Error
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__Microsoft.AspNetCore=Error
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
Logging__LogLevel__SV5T.Infrastructure.Email.EmailBackgroundWorker=Information
