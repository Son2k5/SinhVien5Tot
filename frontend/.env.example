# URL Backend API kết nối tới .NET Web API
VITE_API_URL=/api

# Vite proxy nội bộ đến HTTPS backend khi chạy development
VITE_BACKEND_PROXY_TARGET=https://localhost:7080

# Tên ứng dụng hiển thị
VITE_APP_TITLE=SV5T - Sinh Viên 5 Tốt Portal

# Chế độ Mock API ('true' cho Demo UI, 'false' khi nối Backend API)
VITE_USE_MOCK=false

# Thời hạn lưu Cookie Session (Ngày)
VITE_SESSION_EXPIRES_DAYS=30
