# Public browser configuration only. Every VITE_* value is bundled into the
# frontend and must never contain passwords, private keys, or server API keys.
VITE_API_URL=/api
VITE_API_TIMEOUT_MS=10000
VITE_API_PROXY_PREFIX=/api
VITE_BACKEND_PROXY_TARGET=https://localhost:7080

VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173
VITE_DEV_HTTPS_CERT_PATH=.cert/localhost.pem
VITE_DEV_HTTPS_KEY_PATH=.cert/localhost.key

VITE_APP_TITLE=SV5T - Sinh Viên 5 Tốt Portal
VITE_APP_DESCRIPTION=Hệ thống quản lý hồ sơ và đồng hành cùng sinh viên trên hành trình chinh phục danh hiệu Sinh viên 5 Tốt.
VITE_THEME_COLOR="#2463eb"
VITE_USE_MOCK=false
